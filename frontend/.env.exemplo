# Copie para .env (ignorado pelo Git) e ajuste os valores.
# O app carrega este arquivo com flutter_dotenv (lib/src/config/app_config.dart).
# Emulador Android: 10.0.2.2 aponta para o localhost da máquina.
API_BASE_URL=http://10.0.2.2:8080/api/v1
# Chave do POST /dev/pagamentos/{txid}/confirmar (botão "Simular confirmação", só em debug).
# Igual ao DEV_KEY do backend (no profile simulado, o padrão é dev-key-local).
DEV_KEY=dev-key-local
